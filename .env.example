# Base de données PostgreSQL (tables créées automatiquement au démarrage)
DATABASE_URL=
# SSL activé par défaut ; "false" uniquement pour une base locale
DB_SSL=true

# Port du serveur (fourni par l'hébergeur)
PORT=3001

# Passerelle unique du CHU (origine seule) : service Prescription, Accueil,
# Notifications et registre des services.
GATEWAY_URL=

# Secret HS256 partagé par tous les services du CHU : vérifie les jetons
# entrants et signe le jeton de service pour les appels sortants.
JWT_SECRET=

# Facultatif : nom du service dans le registre central (par défaut
# "Kinésithérapie"), pour retrouver son serviceId et son chuId.
SERVICE_NAME=

# Intervalle de récupération des nouvelles prescriptions (ms)
POLL_INTERVAL_MS=30000
